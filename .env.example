# Local port. Hosts such as Render set PORT themselves.
PORT=8080

# Public site address. Use https://yourdomain.com once the domain is connected.
BASE_URL=http://127.0.0.1:8080

# From https://dashboard.stripe.com/apikeys
# Publishable keys start with pk_test_ or pk_live_.
# Secret keys start with sk_test_ / sk_live_, or restricted rk_test_ / rk_live_ (Checkout Sessions access).
# Leave blank until the Stripe account is ready.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# From Stripe Dashboard → Developers → Webhooks, endpoint https://yourdomain.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Google OAuth 2.0 / OpenID Connect (Web application client).
# Leave blank in git. Set both on Render. Never commit real values.
# Google Cloud Console → APIs & Services → Credentials → OAuth client:
# Authorized JavaScript origins:
#   https://relaypayus.shop
#   https://www.relaypayus.shop
# Authorized redirect URIs:
#   https://relaypayus.shop/api/auth/google/callback
#   https://www.relaypayus.shop/api/auth/google/callback
# Local development (optional):
#   http://127.0.0.1:8080
#   http://localhost:8080
#   http://127.0.0.1:8080/api/auth/google/callback
#   http://localhost:8080/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required only for email/password signup. Google sign-in creates or links the account without this key.
SIGNUP_ACCESS_KEY=
